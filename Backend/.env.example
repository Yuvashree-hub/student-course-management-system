PORT=5000
NODE_ENV=development

# MongoDB connection (local MongoDB). For MongoDB Atlas use the mongodb+srv://... string instead.
MONGO_URI=mongodb://127.0.0.1:27017/acadexa

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# Allowed frontend origin(s), comma separated
CLIENT_URL=http://localhost:5173

# Used by `npm run seed`
ADMIN_EMAIL=admin@acadexa.com
ADMIN_PASSWORD=admin12345

# Password-reset emails (Brevo HTTPS API - free 300/day). Leave blank to skip sending:
# the reset link is then printed in the server console instead.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=ACADEXA
